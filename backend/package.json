{
  "name": "chat-system-backend",
  "version": "1.0.0",
  "description": "Express and Prisma REST API backend for Chat System",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build": "node prisma/prepare-db.js && prisma generate && prisma db push",
    "db:prepare": "node prisma/prepare-db.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.2.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.4"
  }
}
